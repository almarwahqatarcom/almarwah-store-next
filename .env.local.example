# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored by create-next-app's default .gitignore.

# ── SEO ──────────────────────────────────────────────────────────────────────

# The real production domain this deploys to — used by robots.ts/sitemap.ts
# to build absolute URLs. Falls back to shop.almarwah.qa if unset.
NEXT_PUBLIC_SITE_URL=https://shop.almarwah.qa

# ── WhatsApp OTP login (src/app/login) ──────────────────────────────────────

# Random long secret used to sign OTP challenges and phone-verification
# tokens (see src/lib/otp.ts). Nothing is stored server-side — this secret
# IS the "database". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it instantly invalidates every OTP/verification in flight — treat
# it like any other secret key (never commit it, rotate it if it ever leaks).
OTP_SECRET=

# Your n8n webhook URL that sends the WhatsApp message. Create a workflow in
# n8n starting with a Webhook node (POST), followed by whatever WhatsApp
# node/HTTP call you use (WhatsApp Business Cloud API, Twilio, a BSP, etc.).
# This route POSTs JSON: { "phone": "+974XXXXXXXX", "otp": "123456", "message": "Your AlMarwah verification code is 123456..." }
# Your workflow should send `message` (or build its own from `otp`) to `phone`
# and return any 2xx response — the body is ignored, only the status matters.
N8N_WHATSAPP_OTP_WEBHOOK_URL=

# Optional: if your n8n webhook checks a shared secret header before
# proceeding (recommended, so randos can't trigger WhatsApp sends through
# your webhook URL), set the same value here and validate
# `X-Webhook-Secret` in the n8n workflow.
N8N_WEBHOOK_SECRET=

# Shared secret between THIS app and the Laravel backend's `/auth/otp-login`
# endpoint (see README → "OTP login" for the PHP + route code to add there).
# It authenticates src/app/api/otp/complete's server-to-server call — must
# match OTP_INTERNAL_SECRET in the Laravel server's own .env exactly.
# Generate one the same way as OTP_SECRET above (a different value, though —
# don't reuse the same secret for two purposes).
OTP_INTERNAL_SECRET=

# ── Admin dashboard (/admin) ─────────────────────────────────────────────────

# The admin login (email + password) itself is no longer set here — it's a
# row in Supabase's admin_users table now (see
# src/lib/settings/credentials.server.ts), so it can be changed without a
# redeploy and the real password never sits in plaintext in an env file. Set
# or change it any time with:
#   node scripts/seed-admin.mjs "email@example.com" "the password"
# (needs SUPABASE_URL / SUPABASE_SECRET_KEY below already set).

# ── Persistent data (site settings, visitor analytics, admin login) ─────────

# Admin-saved settings (logo, app links, theme, etc.), visitor-tracking
# logs, and the admin login itself are all stored in Supabase (a small
# managed Postgres database, reached over HTTPS) — see
# src/lib/supabase.server.ts, src/lib/settings/store.server.ts,
# src/lib/analytics/store.server.ts and src/lib/settings/credentials.server.ts.
# This app is deployed on a serverless host with no persistent local disk at
# all (not even a folder outside the git checkout — every deploy, and even
# separate requests within one deploy, can land on a completely different
# filesystem), which is why local-file or plaintext-env storage of any of
# this kept silently losing admin-saved settings/visitor data after every
# deploy, and kept the admin password stuck at whatever it was on the last
# deploy. Deliberately NOT routed through the Laravel backend — this is a
# self-contained Next.js concern, no changes or deploys needed on that side.
#
# Setup (free tier is plenty for this):
#   1. Create a project at https://supabase.com
#   2. In the SQL editor, run every CREATE TABLE statement in
#      supabase/schema.sql in this repo (safe to re-run any time you add a
#      new one later — they're all CREATE TABLE IF NOT EXISTS).
#   3. Project Settings → API → copy the "Project URL" and the "secret"
#      API key (NOT the "publishable" key — the secret key is required to
#      bypass Row Level Security for these server-only writes) into the
#      two variables below.
#   4. Set the admin login itself: node scripts/seed-admin.mjs "you@example.com" "a real password"
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Signs the admin dashboard's login cookie (see session.server.ts) — a
# stateless token, not stored anywhere, so there's nothing for a redeploy
# to wipe (the earlier file-based session store had the exact same
# "wiped on every deploy" problem as the settings/visitor data above,
# signing the admin back out constantly). Generate one the same way as
# OTP_SECRET. Changing it instantly signs out every admin session — treat
# it like any other secret key.
ADMIN_SESSION_SECRET=
